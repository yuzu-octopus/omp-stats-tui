node_modules/
/dist/
.DS_Store

# Machine-local dev-loop config. Anchored to the repo root and naming the single
# file, so a legitimate future `.omp/` (e.g. committed per-project modelRoles)
# stays trackable. Ignored rather than committed: an `extensions:` array here
# SUPPRESSES the global one for sessions rooted in this repo (settings arrays
# replace, project layer wins), which is a silent behaviour change for anyone
# who checks out the repo without also having our global config.
/.omp/config.yml

# Scratch files agents have repeatedly dropped in scripts/. The real probes
# (probe-*.ts) and data-worker.ts are tracked; only the tmp- prefix is caught.
/scripts/tmp-*.ts

 # Omp runtime (session data lives in the global store, not here)
 .omp/plugins/
 .omp/cache/
